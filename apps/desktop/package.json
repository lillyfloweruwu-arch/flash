{
  "name": "@flash/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Flash desktop app â€” Electron + React",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.flash.clipper",
    "productName": "Flash",
    "directories": {
      "output": "../../release",
      "buildResources": "../../assets"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../../packages/flash-capture/build/Release/flash_capture.node",
        "to": "flash_capture.node"
      },
      {
        "from": "../../packages/flash-detector/src/games.json",
        "to": "games.json"
      },
      {
        "from": "../../assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../../assets/icons/blood.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flash",
      "runAfterFinish": true,
      "installerHeader": "../../assets/installer/header.bmp",
      "installerSidebar": "../../assets/installer/sidebar.bmp",
      "uninstallerSidebar": "../../assets/installer/sidebar-uninstall.bmp",
      "installerIcon": "../../assets/icons/blood.ico",
      "uninstallerIcon": "../../assets/icons/blood.ico",
      "uninstallDisplayName": "Flash ${version}",
      "include": "installer/flash-autostart.nsh"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/antonio": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
